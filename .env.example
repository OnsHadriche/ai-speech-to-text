# PostgreSQL
POSTGRES_USER=speech_user
POSTGRES_PASSWORD=YOUR_GENERATED_PASSWORD
POSTGRES_DB=speech_word

# Application
APP_ENV=development
MAX_UPLOAD_SIZE_MB=100

# Local FastAPI database connection
DATABASE_URL=postgresql+psycopg://speech_user:YOUR_GENERATED_PASSWORD@localhost:5433/speech_word

# n8n
N8N_ENCRYPTION_KEY=YOUR_GENERATED_ENCRYPTION_KEY

# LLM - configure later
OPENAI_API_KEY=
OPENAI_MODEL=