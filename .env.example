# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Application
APP_ENV=
MAX_UPLOAD_SIZE_MB=

# Local FastAPI database connection
DATABASE_URL=localhost:5433/speech_word

# n8n
N8N_ENCRYPTION_KEY=
# N8N webhook URL for audio processing
N8N_WEBHOOK_URL=

# LLM - configure later
OPENAI_API_KEY=
OPENAI_MODEL=

# GROQ API Key
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=YOUR_GROQ_MODEL
# Storage path for uploaded files
STORAGE_PATH=

# Chunk size for reading files in bytes (1 MB)
CHUNK_SIZE =  
TARGET_SAMPLE_RATE=
# Recovery API Key for secure access to the recovery endpoint
RECOVERY_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=